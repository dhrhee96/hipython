      "source": [
        "# AI 영농일지 및 지원사업 이행 검증 시스템\n",
        "\n",
        "요구사항 기반으로 PoC를 객체지향(OOP) 구조로 리팩토링한 노트북 버전입니다."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import json\n",
        "from dataclasses import dataclass, field\n",
        "from datetime import datetime, date\n",
        "from typing import Any, Dict, List, Optional\n",
        "\n",
        "@dataclass\n",
        "class Task:\n",
        "    id: str\n",
        "    task_type: str\n",
        "    task_name: str\n",
        "    due_date: str\n",
        "    result: str = 'WAITING'\n",
        "    required_docs: List[str] = field(default_factory=list)\n",
        "    submitted_docs: List[str] = field(default_factory=list)\n",
        "    verified_at: Optional[str] = None\n",
        "\n",
        "    @staticmethod\n",
        "    def from_dict(raw: Dict[str, Any]) -> 'Task':\n",
        "        return Task(\n",
        "            id=raw['id'], task_type=raw['task_type'], task_name=raw['task_name'],\n",
        "            due_date=raw['due_date'], result=raw.get('result', 'WAITING'),\n",
        "            required_docs=list(raw.get('required_docs', [])),\n",
        "            submitted_docs=list(raw.get('submitted_docs', [])),\n",
        "            verified_at=raw.get('verified_at')\n",
        "        )\n",
        "\n",
        "class MissingDocumentTracker:\n",
        "    @staticmethod\n",
        "    def get_missing_documents(task: Task) -> List[str]:\n",
        "        submitted = set(task.submitted_docs)\n",
        "        return [d for d in task.required_docs if d not in submitted]\n",
        "\n",
        "class EvidenceProcessor:\n",
        "    LOW_CARBON_PERIOD_START = date(2025, 3, 1)\n",
        "    LOW_CARBON_PERIOD_END = date(2025, 5, 31)\n",
        "\n",
        "    def __init__(self, tasks: List[Task]):\n",
        "        self.tasks = tasks\n",
        "\n",
        "    def _parse_payload(self, payload_json: str) -> Dict[str, Any]:\n",
        "        try:\n",
        "            payload = json.loads(payload_json)\n",
        "        except json.JSONDecodeError as exc:\n",
        "            raise ValueError(f'잘못된 JSON 형식입니다: {exc}') from exc\n",
        "\n",
        "        required = {'todo_id', 'captured_at', 'confirmed_label', 'next_module_payload'}\n",
        "        missing = required - set(payload.keys())\n",
        "        if missing:\n",
        "            raise ValueError(f'필수 필드 누락: {sorted(missing)}')\n",
        "\n",
        "        verify = payload['next_module_payload']\n",
        "        if not isinstance(verify, dict):\n",
        "            raise ValueError('next_module_payload는 dict여야 합니다.')\n",
        "        for key in ('is_location_verified', 'is_timestamp_verified'):\n",
        "            if key not in verify:\n",
        "                raise ValueError(f'검증 필드 누락: {key}')\n",
        "        return payload\n",
        "\n",
        "    def _find_task(self, todo_id: str) -> Optional[Task]:\n",
        "        return next((t for t in self.tasks if t.id == todo_id), None)\n",
        "\n",
        "    def _is_period_valid(self, task: Task, captured_dt: datetime) -> bool:\n",
        "        if task.task_type != '저탄소 사업':\n",
        "            return True\n",
        "        return self.LOW_CARBON_PERIOD_START <= captured_dt.date() <= self.LOW_CARBON_PERIOD_END\n",
        "\n",
        "    def process_webhook(self, payload_json: str) -> Dict[str, str]:\n",
        "        try:\n",
        "            data = self._parse_payload(payload_json)\n",
        "            task = self._find_task(data['todo_id'])\n",
        "            if not task:\n",
        "                return {'status': 'error', 'msg': 'To-Do 매칭 실패'}\n",
        "\n",
        "            captured_dt = datetime.fromisoformat(data['captured_at'])\n",
        "            verify = data['next_module_payload']\n",
        "            base_ok = bool(verify['is_location_verified']) and bool(verify['is_timestamp_verified'])\n",
        "            period_ok = self._is_period_valid(task, captured_dt)\n",
        "\n",
        "            if base_ok and period_ok:\n",
        "                task.result = 'PASS'\n",
        "                task.verified_at = captured_dt.strftime('%Y-%m-%d %H:%M:%S')\n",
        "                evidence = f\"저탄소 농업기술 증빙자료 ({data['confirmed_label']} 사진)\"\n",
        "                if evidence not in task.submitted_docs:\n",
        "                    task.submitted_docs.append(evidence)\n",
        "                return {'status': 'success', 'msg': '검증 완료'}\n",
        "\n",
        "            task.result = 'FAIL'\n",
        "            if not period_ok:\n",
        "                return {'status': 'fail', 'msg': '검증 실패: 사업 기간 외 촬영'}\n",
        "            return {'status': 'fail', 'msg': '검증 실패'}\n",
        "        except Exception as exc:\n",
        "            return {'status': 'error', 'msg': str(exc)}\n",
        "\n",
        "class DashboardGenerator:\n",
        "    def __init__(self, tasks: List[Task]):\n",
        "        self.tasks = tasks\n",
        "\n",
        "    def _event_date(self, task: Task) -> str:\n",
        "        return task.verified_at.split(' ')[0] if task.verified_at else task.due_date\n",
        "\n",
        "    def build_calendar(self) -> Dict[str, List[Dict[str, str]]]:\n",
        "        calendar = {}\n",
        "        for task in sorted(self.tasks, key=self._event_date):\n",
        "            d = self._event_date(task)\n",
        "            calendar.setdefault(d, []).append({\n",
        "                'id': task.id, 'task_type': task.task_type, 'task_name': task.task_name, 'result': task.result\n",
        "            })\n",
        "        return calendar\n",
        "\n",
        "    def print_dashboard(self):\n",
        "        print('🚨 누락 서류 경고')\n",
        "        for task in self.tasks:\n",
        "            missing = MissingDocumentTracker.get_missing_documents(task)\n",
        "            if missing:\n",
        "                print(f'- [{task.id}] {task.task_name}: {missing}')\n",
        "\n",
        "        print('\\n📅 날짜별 통합 일정')\n",
        "        for day, events in self.build_calendar().items():\n",
        "            print(f'[{day}]')\n",
        "            for e in events:\n",
        "                print(f\"  - ({e['task_type']}) {e['task_name']} => {e['result']}\")\n",
        "\n",
        "class ReportExporter:\n",
        "    def __init__(self, tasks: List[Task]):\n",
        "        self.tasks = tasks\n",
        "\n",
        "    def export_to_dataframe(self):\n",
        "        import pandas as pd\n",
        "        filtered = [t for t in self.tasks if t.task_type == '일반 영농' or t.result == 'PASS']\n",
        "        return pd.DataFrame([{'id': t.id, 'task_type': t.task_type, 'task_name': t.task_name, 'due_date': t.due_date, 'verified_at': t.verified_at, 'result': t.result} for t in filtered])\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "db_tasks = [\n",
        "    {\n",
        "        'id': 'todo_001', 'task_type': '저탄소 사업', 'task_name': '바이오차 투입',\n",
        "        'due_date': '2026-05-31', 'result': 'WAITING',\n",
        "        'required_docs': ['저탄소 농업기술 증빙자료 (바이오차 살포 사진)', '생산현황보고서(서식2)'],\n",
        "        'submitted_docs': ['생산현황보고서(서식2)']\n",
        "    },\n",
        "    {\n",
        "        'id': 'todo_002', 'task_type': '일반 영농', 'task_name': '밭갈기 (경운 작업)',\n",
        "        'due_date': '2026-04-01', 'result': 'WAITING',\n",
        "        'required_docs': [], 'submitted_docs': []\n",
        "    }\n",
        "]\n",
        "tasks = [Task.from_dict(t) for t in db_tasks]\n",
        "processor = EvidenceProcessor(tasks)\n",
        "payload = json.dumps({\n",
        "    'todo_id': 'todo_001',\n",
        "    'captured_at': '2025-05-20T09:10:11',\n",
        "    'confirmed_label': '바이오차 살포',\n",
        "    'next_module_payload': {'is_location_verified': True, 'is_timestamp_verified': True}\n",
        "})\n",
        "print(processor.process_webhook(payload))\n",
        "DashboardGenerator(tasks).print_dashboard()"
      ]
    },
    {
