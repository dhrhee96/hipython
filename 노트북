      "source": [
        "## 검증 시나리오\n",
        "- 성공(사업기간 내 + 위치/시간 검증 통과)\n",
        "- 실패(사업기간 외)\n",
        "- 실패(위치 검증 실패)\n",
        "- 에러(필수 필드 누락)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "scenarios = [\n",
        "    {'name': '성공', 'payload': {'todo_id':'todo_001','captured_at':'2025-05-20T09:10:11','confirmed_label':'바이오차 살포','next_module_payload': {'is_location_verified': True, 'is_timestamp_verified': True}}},\n",
        "    {'name': '기간외 실패', 'payload': {'todo_id':'todo_001','captured_at':'2025-06-01T09:10:11','confirmed_label':'바이오차 살포','next_module_payload': {'is_location_verified': True, 'is_timestamp_verified': True}}},\n",
        "    {'name': '기본검증 실패', 'payload': {'todo_id':'todo_001','captured_at':'2025-05-20T09:10:11','confirmed_label':'바이오차 살포','next_module_payload': {'is_location_verified': False, 'is_timestamp_verified': True}}},\n",
        "    {'name': '필드누락 에러', 'payload': {'todo_id':'todo_001','captured_at':'2025-05-20T09:10:11','next_module_payload': {'is_location_verified': True, 'is_timestamp_verified': True}}},\n",
        "]\n",
        "\n",
        "for s in scenarios:\n",
        "    tasks = [Task.from_dict(t) for t in db_tasks]\n",
        "    processor = EvidenceProcessor(tasks)\n",
        "    result = processor.process_webhook(json.dumps(s['payload'], ensure_ascii=False))\n",
        "    print(f\"[{s['name']}] -> {result}\")"
      ]
    }
